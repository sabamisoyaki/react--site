# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code
.claude/

/generated/prisma

# SSH tunnel PID tracking (auto-generated by scripts/start-tunnel.mjs)
.tunnel.pid

# AI-written research, audits, and plans. docs/ is a local workspace and is NEVER
# tracked -- the exclusion covers every file under it, docs/README.md and the
# subfolder indexes included. There are no per-file exceptions, so do not use
# `git add -f` to slip one in. Anything that has to reach everyone who clones the
# repo belongs outside docs/: put it in AGENTS.md or next to the code it describes.
# See the docs/ section of AGENTS.md.
/docs
