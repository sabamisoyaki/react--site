{
  "name": "my-app2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/start-tunnel.mjs && npm run lint && next dev",
    "dev:local": "next dev",
    "build": "next build",
    "start": "next start",
    "db:seed": "tsx prisma/seed.ts",
    "test": "npm run test:account && npm run test:search && npm run test:clips && npm run test:db",
    "test:account": "node --test \"tests/account/accountViewModel.test.mjs\"",
    "test:search": "node --test \"tests/search/utils.test.mjs\"",
    "test:clips": "node --test \"tests/clips/playback.test.mjs\"",
    "test:db": "node --test \"tests/db/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit --pretty false",
    "codex:quick": "node scripts/codex-harness.mjs quick",
    "codex:schema": "node scripts/codex-harness.mjs schema",
    "codex:db": "node scripts/codex-harness.mjs db",
    "codex:full": "node scripts/codex-harness.mjs full",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/core": "^0.40.0",
    "@auth/prisma-adapter": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.29",
    "pg": "^8.21.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@lavamoat/allow-scripts": "^3.4.3",
    "@lavamoat/preinstall-always-fail": "^2.1.1",
    "@prisma/generator-helper": "^7.4.0",
    "@prisma/internals": "^7.4.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prisma": "^7.4.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome format --write --no-errors-on-unmatched",
      "biome check"
    ],
    "*.{json,md,css,scss}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "next>sharp": false,
      "prisma": false,
      "prisma>@prisma/engines": false,
      "tsx>esbuild": false
    }
  }
}
